{
  "name": "agent-hub",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Single source of truth for your AI coding agents: skills, MCP, instructions, memory, task state.",
  "type": "module",
  "bin": {
    "agent-hub": "dist/cli.js",
    "ahub": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "qa:ui": "npm run build && node tests/qa-harness.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:coverage": "npm run build && node scripts/test.mjs --coverage",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm run typecheck && npm test",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs",
    "install:check": "npm run build && node scripts/check-global-install.mjs",
    "install:global": "npm run build && node scripts/install-global.mjs",
    "docs:commands": "npm run build && node scripts/write-command-reference.mjs",
    "release:prepare": "npm run build && node scripts/prepare-release.mjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "files": [
    "dist/",
    "ui/app/",
    "README.md",
    "docs/README.md",
    "docs/QUICKSTART.md",
    "docs/CONTENT.md",
    "docs/MEMORY.md",
    "docs/AUTOMATION.md",
    "docs/WORKING_GUIDE.md",
    "docs/RECOVERY.md",
    "docs/DESIGN.md",
    "LICENSE",
    "npm-shrinkwrap.json",
    "docs/CLI.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/RELEASE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-agent-hub/agent-hub.git"
  },
  "bugs": {
    "url": "https://github.com/get-agent-hub/agent-hub/issues"
  },
  "homepage": "https://getahub.dev"
}
