{
  "name": "agent-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for your AI coding agents: skills, MCP, instructions, memory, task state.",
  "type": "module",
  "bin": {
    "agent-hub": "dist/cli.js",
    "ahub": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "qa:ui": "npm run build && node tests/qa-harness.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:coverage": "npm run build && node scripts/test.mjs --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "files": [
    "dist/",
    "ui/app/",
    "README.md",
    "LICENSE"
  ]
}
